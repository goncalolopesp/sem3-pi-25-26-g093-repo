ALTER TABLE Locomotive ADD CONSTRAINT FKLocomotive415770 FOREIGN KEY (operatorID) REFERENCES Operator (operatorID);
ALTER TABLE Wagon_Freight ADD CONSTRAINT FKWagon_Frei975897 FOREIGN KEY (wagonID) REFERENCES Wagon (wagonID);
ALTER TABLE Wagon_Freight ADD CONSTRAINT FKWagon_Frei206959 FOREIGN KEY (freightID) REFERENCES Freight (freightID);
ALTER TABLE Freight ADD CONSTRAINT FKFreight384143 FOREIGN KEY (trainID) REFERENCES Train (trainID);
ALTER TABLE Locomotive ADD CONSTRAINT FKLocomotive374078 FOREIGN KEY (trainID) REFERENCES Train (trainID);
ALTER TABLE Siding ADD CONSTRAINT FKSiding702577 FOREIGN KEY (railwaySegmentID) REFERENCES Railway_Segment (id);
ALTER TABLE Locomotive_Model_Gauge ADD CONSTRAINT FKLocomotive13939 FOREIGN KEY (locomotiveModelID) REFERENCES Locomotive_Model (locomotiveModelID);
ALTER TABLE Locomotive_Model_Gauge ADD CONSTRAINT FKLocomotive495002 FOREIGN KEY (gaugeID) REFERENCES Gauge (gaugeID);
ALTER TABLE Wagon_Model_Gauge ADD CONSTRAINT FKWagon_Mode149530 FOREIGN KEY (wagonModelID) REFERENCES Wagon_Model (wagonModelID);
ALTER TABLE Wagon_Model_Gauge ADD CONSTRAINT FKWagon_Mode740646 FOREIGN KEY (gaugeID) REFERENCES Gauge (gaugeID);
ALTER TABLE Railway_Line ADD CONSTRAINT FKRailway_Li336626 FOREIGN KEY (gaugeID) REFERENCES Gauge (gaugeID);
ALTER TABLE Facility_Path ADD CONSTRAINT FKFacility_P409019 FOREIGN KEY (Facilityid) REFERENCES Facility (id);
ALTER TABLE Facility_Path ADD CONSTRAINT FKFacility_P359707 FOREIGN KEY (PathpathID) REFERENCES Path (pathID);
ALTER TABLE Train ADD CONSTRAINT FKTrain178822 FOREIGN KEY (pathID) REFERENCES Path (pathID);

