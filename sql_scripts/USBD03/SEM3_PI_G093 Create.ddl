CREATE TABLE Building (id number(10) GENERATED AS IDENTITY, facilityID number(10) NOT NULL, buildingTypeID number(10) NOT NULL, name varchar2(100) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Building_Type (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Cargo (id number(10) GENERATED AS IDENTITY, cargoTypeID number(10) NOT NULL, buildingID number(10) NOT NULL, quantity number(10, 2) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Cargo_Type (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Diesel_Locomotive_Model (locomotiveModelID number(10) NOT NULL, fuelCapacity number(10, 2) NOT NULL, PRIMARY KEY (locomotiveModelID));
CREATE TABLE Electric_Locomotive_Model (locomotiveModelID number(10) NOT NULL, voltage number(10) NOT NULL, frequence number(10) NOT NULL, PRIMARY KEY (locomotiveModelID));
CREATE TABLE Facility (id number(10) GENERATED AS IDENTITY, facilityTypeID number(10) NOT NULL, name varchar2(100) NOT NULL, posX number(22) NOT NULL, posY number(22) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Facility_Path (facilitiesID number(10) NOT NULL, pathID number(10) NOT NULL, sequenceOrder varchar2(50) NOT NULL, PRIMARY KEY (facilitiesID, pathID));
CREATE TABLE Facility_Type (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Freight (freightID number(10) GENERATED AS IDENTITY, trainID number(10) NOT NULL, startFacilityID number(10) NOT NULL, endFacilityID number(10) NOT NULL, freightDate date NOT NULL, PRIMARY KEY (freightID));
CREATE TABLE Locomotive (locomotiveID number(10) GENERATED AS IDENTITY, operatorID number(10) NOT NULL, locomotiveModelID number(10) NOT NULL, trainID number(10) NOT NULL, name varchar2(30) NOT NULL, startYear number(4) NOT NULL, model varchar2(30) NOT NULL, identifier varchar2(20) NOT NULL, PRIMARY KEY (locomotiveID));
CREATE TABLE Locomotive_Model (locomotiveModelID number(10) GENERATED AS IDENTITY, power double precision NOT NULL, topSpeed double precision NOT NULL, trackType number(10) NOT NULL, gauge double precision NOT NULL, tareWeight number(10) NOT NULL, maxWeight number(10) NOT NULL, numberOfBogies number(10) NOT NULL, maker varchar2(10) NOT NULL, PRIMARY KEY (locomotiveModelID));
CREATE TABLE Operator (operatorID number(10) GENERATED AS IDENTITY, vatNumber varchar2(20) NOT NULL, shortName varchar2(10) NOT NULL, name varchar2(50) NOT NULL, PRIMARY KEY (operatorID));
CREATE TABLE Owner (ownerID number(10) GENERATED AS IDENTITY, vatNumber varchar2(20) NOT NULL, name varchar2(50) NOT NULL, shortName varchar2(10) NOT NULL, PRIMARY KEY (ownerID));
CREATE TABLE Path (pathID number(10) GENERATED AS IDENTITY, trainID number(10) NOT NULL, PRIMARY KEY (pathID));
CREATE TABLE Railway_Line (id number(10) GENERATED AS IDENTITY, startFacilityID number(10) NOT NULL, endFacilityID number(10) NOT NULL, ownerID number(10) NOT NULL, name varchar2(100) NOT NULL, gauge number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Railway_Segment (id number(10) GENERATED AS IDENTITY, railwayLineID number(10) NOT NULL, segmentOrder number(22) NOT NULL, sidingPosition number(10), sidingLength number(10), isElectrified char(1) NOT NULL, length number(22) NOT NULL, numberTracks number(10) NOT NULL, weightLimit number(22) NOT NULL, PRIMARY KEY (id), CONSTRAINT segmentOrderLine UNIQUE (segmentOrder, railwayLineID));
CREATE TABLE Train (trainID number(10) GENERATED AS IDENTITY, operatorID number(10) NOT NULL, startDate date NOT NULL, startTime varchar2(5) NOT NULL, PRIMARY KEY (trainID));
CREATE TABLE Wagon (wagonID number(10) GENERATED AS IDENTITY, operatorID number(10) NOT NULL, wagonModelID number(10) NOT NULL, identifier varchar2(20) NOT NULL, PRIMARY KEY (wagonID));
CREATE TABLE Wagon_Freight (wagonID number(10) NOT NULL, freightID number(10) NOT NULL, PRIMARY KEY (wagonID, freightID));
CREATE TABLE Wagon_Model (wagonModelID number(10) GENERATED AS IDENTITY, wagonModelTypeID number(10) NOT NULL, capacity number(10) NOT NULL, volumeCapacity number(10) NOT NULL, length double precision NOT NULL, height number(10) NOT NULL, maxSpeed number(10) NOT NULL, gauge double precision NOT NULL, maker varchar2(10) NOT NULL, tareWeight number(10) NOT NULL, numberOfBogies number(10) NOT NULL, PRIMARY KEY (wagonModelID));
CREATE TABLE Wagon_Model_Type (wagonModelTypeID number(10) GENERATED AS IDENTITY, typeName varchar2(40) NOT NULL, PRIMARY KEY (wagonModelTypeID));
ALTER TABLE Railway_Segment ADD CONSTRAINT FKRailway_Se193688 FOREIGN KEY (railwayLineID) REFERENCES Railway_Line (id);
ALTER TABLE Building ADD CONSTRAINT FKBuilding337242 FOREIGN KEY (buildingTypeID) REFERENCES Building_Type (id);
ALTER TABLE Building ADD CONSTRAINT FKBuilding540567 FOREIGN KEY (facilityID) REFERENCES Facility (id);
ALTER TABLE Railway_Line ADD CONSTRAINT FKRailway_Li518917 FOREIGN KEY (ownerID) REFERENCES Owner (ownerID);
ALTER TABLE Cargo ADD CONSTRAINT FKCargo686681 FOREIGN KEY (cargoTypeID) REFERENCES Cargo_Type (id);
ALTER TABLE Cargo ADD CONSTRAINT FKCargo479240 FOREIGN KEY (buildingID) REFERENCES Building (id);
ALTER TABLE Railway_Line ADD CONSTRAINT FKRailway_Li146137 FOREIGN KEY (startFacilityID) REFERENCES Facility (id);
ALTER TABLE Railway_Line ADD CONSTRAINT FKRailway_Li111599 FOREIGN KEY (endFacilityID) REFERENCES Facility (id);
ALTER TABLE Facility ADD CONSTRAINT FKFacility616056 FOREIGN KEY (facilityTypeID) REFERENCES Facility_Type (id);
ALTER TABLE Wagon ADD CONSTRAINT FKWagon197129 FOREIGN KEY (wagonModelID) REFERENCES Wagon_Model (wagonModelID);
ALTER TABLE Locomotive ADD CONSTRAINT FKLocomotive523003 FOREIGN KEY (locomotiveModelID) REFERENCES Locomotive_Model (locomotiveModelID);
ALTER TABLE Electric_Locomotive_Model ADD CONSTRAINT FKElectric_L456013 FOREIGN KEY (locomotiveModelID) REFERENCES Locomotive_Model (locomotiveModelID);
ALTER TABLE Diesel_Locomotive_Model ADD CONSTRAINT FKDiesel_Loc102542 FOREIGN KEY (locomotiveModelID) REFERENCES Locomotive_Model (locomotiveModelID);
ALTER TABLE Wagon_Model ADD CONSTRAINT FKWagon_Mode272526 FOREIGN KEY (wagonModelTypeID) REFERENCES Wagon_Model_Type (wagonModelTypeID);
ALTER TABLE Train ADD CONSTRAINT FKTrain112304 FOREIGN KEY (operatorID) REFERENCES Operator (operatorID);
ALTER TABLE Facility_Path ADD CONSTRAINT FKFacility_P818379 FOREIGN KEY (facilitiesID) REFERENCES Facility (id);
ALTER TABLE Facility_Path ADD CONSTRAINT FKFacility_P356095 FOREIGN KEY (pathID) REFERENCES Path (pathID);
ALTER TABLE Freight ADD CONSTRAINT FKFreight242982 FOREIGN KEY (startFacilityID) REFERENCES Facility (id);
ALTER TABLE Freight ADD CONSTRAINT FKFreight277520 FOREIGN KEY (endFacilityID) REFERENCES Facility (id);
ALTER TABLE Path ADD CONSTRAINT FKPath882447 FOREIGN KEY (trainID) REFERENCES Train (trainID);
ALTER TABLE Wagon ADD CONSTRAINT FKWagon842233 FOREIGN KEY (operatorID) REFERENCES Operator (operatorID);
ALTER TABLE Locomotive ADD CONSTRAINT FKLocomotive415770 FOREIGN KEY (operatorID) REFERENCES Operator (operatorID);
ALTER TABLE Wagon_Freight ADD CONSTRAINT FKWagon_Frei975897 FOREIGN KEY (wagonID) REFERENCES Wagon (wagonID);
ALTER TABLE Wagon_Freight ADD CONSTRAINT FKWagon_Frei206959 FOREIGN KEY (freightID) REFERENCES Freight (freightID);
ALTER TABLE Freight ADD CONSTRAINT FKFreight384143 FOREIGN KEY (trainID) REFERENCES Train (trainID);
ALTER TABLE Locomotive ADD CONSTRAINT FKLocomotive374078 FOREIGN KEY (trainID) REFERENCES Train (trainID);

