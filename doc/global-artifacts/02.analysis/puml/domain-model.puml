@startuml
hide circle
hide methods
skinparam monochrome true
skinparam classAttributeIconSize 0
skinparam shadowing false

abstract class Facility {
  +name
  +posX
  +posY
  +isIntermodal
}

class Station {}
class Terminal {}
class FreightYard {}

Facility <|-- Station
Facility <|-- Terminal
Facility <|-- FreightYard

class RailwayLine {
  +name
  +gauge
}

class RailwaySegment {
  +segmentOrder
  +sidingPosition
  +sidingLength
  +isElectrified
  +length
  +numberTracks
  +speedLimit
  +weightLimit
  +gauge
}

class Owner {
  +name
}

Owner "1" --> "0..*" RailwayLine
RailwayLine *-- "1..*" RailwaySegment
RailwayLine --> "1" Facility : start >
RailwayLine --> "1" Facility : end >

abstract class RollingStock {
  +gauge
  +tareWeight
  +maxWeight
  +numberOfBogies
}

class Locomotive {
  +name
  +startYear
}

class Wagon {
  +name
}

RollingStock <|-- Locomotive
RollingStock <|-- Wagon

abstract class LocomotiveModel {
  +model
  +power
  +acceleration
  +topSpeed
  +trackType
  +gauge
}

class DieselLocomotiveModel {
  +fuelCapacity
}

class ElectricLocomotiveModel {
  +voltage
  +frequency
}

LocomotiveModel <|-- DieselLocomotiveModel
LocomotiveModel <|-- ElectricLocomotiveModel
Locomotive --> LocomotiveModel

abstract class WagonModel {
  +capacity
  +volumeCapacity
  +length
  +height
  +maxSpeed
  +gauge
}

class Boxcar {}
class Flatcar {}
class TankCar {}
class HopperCar {}
class RefrigeratedCar {}

WagonModel <|-- Boxcar
WagonModel <|-- Flatcar
WagonModel <|-- TankCar
WagonModel <|-- HopperCar
WagonModel <|-- RefrigeratedCar
Wagon --> WagonModel

class Cargo {
  +quantity
}

class CargoType {
  +typeName
}

class Building {
  +name
}

class Warehouse {}
class GrainSilo {}
class RefrigeratedArea {}

Building <|-- Warehouse
Building <|-- GrainSilo
Building <|-- RefrigeratedArea

Facility "1" --> "0..*" Building
Cargo --> CargoType
Cargo --> Building

class Freight {}

Freight --> Facility : origin >
Freight --> Facility : destination >
Freight *-- "1..*" Wagon

class Train {
  +name
  +startDate
  +startTime
}

Train *-- "1..*" Locomotive
Train *-- "1..*" Freight

class Operator {
  +name
}

Operator "1" --> "0..*" Train

class Route {
  +isComplex
  +description
}

Operator "1" --> "0..*" Route
Train --> "1" Route

class Path {
  +sequenceOrder
  +plannedTime
}

Route "1" --> "1..*" Path
Path --> "1" Facility

Operator "1" --> "0..*" RollingStock
Wagon "1" --> "0..*" Cargo

@enduml
