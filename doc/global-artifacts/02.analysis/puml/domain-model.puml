@startuml
hide circle
hide methods
skinparam monochrome true
skinparam classAttributeIconSize 0
skinparam shadowing false

' ===================== INFRASTRUCTURE =====================
package "Infrastructure" {

  abstract class Facility {
    +name
    +latitude
    +longitude
    +isIntermodal
  }

  class Station
  class Terminal
  class FreightYard

  Facility <|-- Station
  Facility <|-- Terminal
  Facility <|-- FreightYard

  class Owner {
    +name
  }

  class Gauge {
    +name
    +widthMM
  }

  class RailwayLine {
    +name
  }

  class RailwaySegment {
    +length
    +electrified
    +numberTracks
    +speedLimit
    +weightLimit
  }

  Owner "1" -- "1..*" RailwayLine : owns >
  RailwayLine "1" -- "1..*" RailwaySegment : composedOf >
  RailwayLine "1" -- "1" Facility : startsAt >
  RailwayLine "1" -- "1" Facility : endsAt >

  Gauge "1" -- "0..*" RailwayLine : allowedOn >
  Gauge "1" -- "0..*" RailwaySegment : supports >
}

' ===================== BUILDINGS & CARGO =====================
package "Facilities & Cargo" {

  class Building {
    +name
  }

  class Warehouse
  class GrainSilo
  class RefrigeratedArea

  Building <|-- Warehouse
  Building <|-- GrainSilo
  Building <|-- RefrigeratedArea

  Facility "1" -- "0..*" Building : contains >

  class Cargo {
    +quantity
  }

  class CargoType {
    +typeName
  }

  Cargo "1" -- "1" CargoType : ofType >
  Cargo "1" -- "1" Building : storedAt >
}

' ===================== OPERATORS & ROLLING STOCK =====================
package "Rolling Stock & Operators" {

  class Operator {
    +name
    +shortName
  }

  abstract class RollingStock {
    +gauge
    +tareWeight
    +maxWeight
    +numberOfBogies
  }

  class Locomotive {
    +name
    +serviceYear
  }

  class Wagon {
    +name
    +serviceYear
  }

  RollingStock <|-- Locomotive
  RollingStock <|-- Wagon

  abstract class LocomotiveModel {
    +make
    +model
    +power
    +acceleration
    +maxSpeed
    +weight
  }

  class DieselLocomotiveModel {
    +fuelCapacity
  }

  class ElectricLocomotiveModel {
    +voltage
    +frequency
  }

  LocomotiveModel <|-- DieselLocomotiveModel
  LocomotiveModel <|-- ElectricLocomotiveModel

  Locomotive "1" -- "1" LocomotiveModel : ofModel >

  class WagonModel {
    +capacity
    +volumeCapacity
    +length
    +height
    +maxSpeed
  }

  class Boxcar
  class Flatcar
  class TankCar
  class HopperCar
  class RefrigeratedCar

  WagonModel <|-- Boxcar
  WagonModel <|-- Flatcar
  WagonModel <|-- TankCar
  WagonModel <|-- HopperCar
  WagonModel <|-- RefrigeratedCar

  Wagon "1" -- "1" WagonModel : ofModel >

  Operator "1" -- "0..*" RollingStock : owns >
}

' ===================== FREIGHT, TRAINS & ROUTES =====================
package "Freight & Train Operations" {

  class Freight {
    +departureTime
    +arrivalTime
    +status
  }

  Freight "1" -- "1" Facility : origin >
  Freight "1" -- "1" Facility : destination >
  Freight "1" -- "1..*" Wagon : includes >

  class Train {
    +name
    +plannedStartDateTime
  }

  ' Correct: a Train is pulled by 1..* locomotives
  Train "1" -- "1..*" Locomotive : isPulledBy >

  Train "1" -- "1..*" Freight : carries >

  class Route {
    +description
    +isComplex
  }

  Train "1" -- "1" Route : follows >

  class Path {
    +sequenceOrder
    +plannedTime
  }

  Route "1" -- "1..*" Path : consistsOf >
  Path "1" -- "1" Facility : refersTo >
}

@enduml
