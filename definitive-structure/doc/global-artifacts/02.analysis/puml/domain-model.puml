@startuml
hide circle
hide methods
skinparam monochrome true
skinparam classAttributeIconSize 0
skinparam shadowing false

class Station {
  +name
  +position
}
enum StationTypeName {
  FreightYard
  Terminal
  Intermodal
}
Station --> StationTypeName : ofType >

class RailwayLine {
  +name
  +length
}
class RailwaySegment {
  +length
  +gauge
  +isElectrified
  +trackType
  +trackConfiguration
  +speedLimit
  +weightLimit
}
RailwayLine *-- "1..*" RailwaySegment : composedOf >
RailwayLine --> "1" Station : start >
RailwayLine --> "1" Station : end >


abstract class Operator {
  +name
}
class InfrastructureManager {
  +maintenanceAreas
}
class TrainOperator {
  +fleetSize
}
Operator <|-- InfrastructureManager
Operator <|-- TrainOperator

InfrastructureManager "1" --> "0..*" RailwayLine : owns >

abstract class RollingStock {
  +gauge
  +tareWeight
  +maxWeight
}
RollingStock <|-- Locomotive
RollingStock <|-- Wagon

abstract class Locomotive {
  +make
  +model
  +power
  +acceleration
  +startYear
  +numberOfBogies
  +tareWeight
  +dimensions
}
class DieselLocomotive {
  +fuelCapacity
}
class ElectricLocomotive {

}
Locomotive <|-- DieselLocomotive
Locomotive <|-- ElectricLocomotive
ElectricLocomotive --> RailwaySegment : operatesOn (electrified only) >

abstract class Wagon {
  +payloadCapacity
  +volumeCapacity
  +tareWeight
  +dimensions
}
class Boxcar {}
class Flatcar {}
class TankCar {
  +liquidType
}
class HopperCar {
  +materialType
}
class RefrigeratedCar {
  +temperatureRange
}
Wagon <|-- Boxcar
Wagon <|-- Flatcar
Wagon <|-- TankCar
Wagon <|-- HopperCar
Wagon <|-- RefrigeratedCar

TrainOperator "1" --> "0..*" Locomotive : operates >
TrainOperator "1" --> "0..*" Wagon : manages >


class Cargo {
  +description
  +weight
  +volume
  +isPerishable
  +temperatureRequirement
}
enum CargoType {
  GeneralGoods
  Container
  Liquid
  Grain
  Chemical
  Refrigerated
}
Cargo --> CargoType : ofType >
Wagon --> "0..*" Cargo : transports >

class Route {
  +name
  +description
}
class RouteStation {
  +sequenceOrder
}
Route *-- "2..*" RouteStation : includes >
RouteStation --> "1" Station : station >

class Building{
    +name
}

enum BuildingType{
    WareHouse
    GrainSilo
    RefrigeratedArea
}

Building --> BuildingType : ofType >
Station "1" --> "0..*" Building : includes >
TrainOperator "1" --> "0..*" Route : defines >

@enduml
