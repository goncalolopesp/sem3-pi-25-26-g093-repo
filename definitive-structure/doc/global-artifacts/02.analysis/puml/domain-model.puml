@startuml
hide circle
hide methods
skinparam monochrome true
skinparam classAttributeIconSize 0
skinparam shadowing false

abstract class Facility {
  +name
  +position
  +isIntermodal
}

class Station {}
class Terminal {
}
class FreightYard {
}

Facility <|-- Station
Facility <|-- Terminal
Facility <|-- FreightYard


class RailwayLine {
  +name
  +length
}
class RailwaySegment {
  +length
  +gauge
  +isElectrified
  +trackType
  +trackConfiguration
  +speedLimit
  +weightLimit
  +hasSiding
}

RailwayLine *-- "1..*" RailwaySegment : composedOf >
RailwayLine --> "1" Facility : start >
RailwayLine --> "1" Facility : end >


class Owner {
+name
}
class Operator {
+name
}


Owner "1" --> "0..*" RailwayLine : owns >

abstract class RollingStock {
  +gauge
  +tareWeight
  +maxWeight
  +numberOfBogies

}

abstract class LocomotiveModel {
  +model
  +power
  +acceleration
  +startYear
  +gauge
}
class DieselLocomotive {
  +fuelCapacity
}
class ElectricLocomotive {
+voltage
+frequency
}
LocomotiveModel <|-- DieselLocomotive
LocomotiveModel <|-- ElectricLocomotive

note on link
  Electric locomotives can only operate on
  railway segments where isElectrified = true
end note

abstract class WagonModel {
  +payloadCapacity
  +volumeCapacity
  +dimensions
}
class Boxcar {}
class Flatcar {}
class TankCar {
 }
class HopperCar {
 }
class RefrigeratedCar {
 }
WagonModel <|-- Boxcar
WagonModel <|-- Flatcar
WagonModel <|-- TankCar
WagonModel <|-- HopperCar
WagonModel <|-- RefrigeratedCar

Operator "1" --> "0..*" RollingStock : operates >

class  Cargo {
  +description
  +weight
  +volume
}
enum CargoType {
}
Cargo --> CargoType : ofType >
WagonModel --> "1" Cargo : transports >


class Building {
  +name
}

Class Warehouse{}
Class GrainSilo{}
Class RefrigeratedArea{}


Building <|-- Warehouse
Building <|-- GrainSilo
Building <|-- RefrigeratedArea


Facility "1" --> "0..*" Building : includes >
Cargo --> Building : storedIn >

note right of RailwayLine
  Each RailwayLine is owned by exactly one Owner (Enterprise),
  and may be operated by one or more Operators (different Enterprises).
  The same Enterprise cannot be both the Owner and Operator
  of the same RailwayLine.
end note

Locomotive <|-- LocomotiveModel
Wagon <|-- WagonModel

RollingStock <|-- Locomotive
RollingStock <|-- Wagon


class Siding {
  +name
  +length
  +position
}

class Locomotive{
+name
+startYear
}

class Wagon{
+name
}

class Freight{
}

class Train{
+name
}

Freight --> "1" Facility : origin >
Freight --> "1" Facility : destination >

Train *-- "1..*" Locomotive : consists of >
Train *-- "1..*" Freight : carries >
Operator "1" --> "0..*" Route : defines >
Operator "1" --> "0..*" Train : operates >


Freight *-- "1..*" Wagon : consists of a set of >

class Route {
  +name
  +isComplex
  +description
}

class RouteFacility {
  +sequenceOrder
  +isStop
}

Route *-- "1..*" RouteFacility : composedOf >
RouteFacility --> "1" Facility : refersTo >

Train --> "1" Route : follows >

note right of RailwaySegment
  Sidings only exist on single-track segments.
  Use 'hasSiding' = true only if trackConfiguration = "Single".
end note
RailwaySegment "1" --> "0..*" Siding : includes >

@enduml
