@startuml
hide circle
hide methods
skinparam monochrome true
skinparam classAttributeIconSize 0
skinparam shadowing false

class Station {
  +name
  +position
  +isIntermodal
}

class RailwayLine {
  +name
  +length
  +startStation
  +endStation
}
class RailwaySegment {
  +length
  +gauge
  +isElectrified
  +trackType
  +trackConfiguration
  +speedLimit
  +weightLimit
  +hasSiding
}

RailwayLine *-- "1..*" RailwaySegment : composedOf >
RailwayLine --> "1" Station : start >
RailwayLine --> "1" Station : end >

class Enterprise {
  +name
}
class Owner {
}
class Operator {
}
Enterprise <|-- Owner
Enterprise <|-- Operator

Owner "1" --> "0..*" RailwayLine : owns >

abstract class RollingStock {
  +gauge
  +tareWeight
  +maxWeight
}

abstract class Locomotive {
  +make
  +model
  +power
  +acceleration
  +startYear
  +numberOfBogies
}
class DieselLocomotive {
  +fuelCapacity
}
class ElectricLocomotive {
}
Locomotive <|-- DieselLocomotive
Locomotive <|-- ElectricLocomotive

note on link
  Electric locomotives can only operate on
  railway segments where isElectrified = true
end note

abstract class Wagon {
  +payloadCapacity
  +volumeCapacity
}
class Boxcar {}
class Flatcar {}
class TankCar {
  +liquidType
}
class HopperCar {
  +materialType
}
class RefrigeratedCar {
  +temperatureRange
}
Wagon <|-- Boxcar
Wagon <|-- Flatcar
Wagon <|-- TankCar
Wagon <|-- HopperCar
Wagon <|-- RefrigeratedCar

Operator "1" --> "0..*" Locomotive : operates >
Operator "1" --> "0..*" Wagon : manages >

class  Cargo {
  +description
  +weight
  +volume
  +isPerishable
  +temperatureRequirement
}
enum CargoType {
  GeneralGoods
  Container
  Liquid
  Grain
  Chemical
  Refrigerated
}
Cargo --> CargoType : ofType >
Wagon --> "1" Cargo : transports >

class Route {
  +name
  +isComplex
  +description
}
class RouteStation {
  +sequenceOrder
}
Route *-- "2..*" RouteStation : includes >
RouteStation --> "1" Station : station >

class Building {
  +name
}
enum BuildingType {
  WareHouse
  GrainSilo
  RefrigeratedArea
}
Building --> BuildingType : ofType >
Station "1" --> "0..*" Building : includes >
Operator "1" --> "0..*" Route : defines >
Cargo --> Building : storedIn >
Operator "1" --> "0..*" RailwayLine : operates >

note right of RailwayLine
  Each RailwayLine is owned by exactly one Owner (Enterprise),
  and may be operated by one or more Operators (different Enterprises).
  The same Enterprise cannot be both the Owner and Operator
  of the same RailwayLine.
end note

RollingStock <|-- Locomotive
RollingStock <|-- Wagon

class Terminal{
+capacity
}

class FreightYard{
+storageCapacity
+numTracks
}

Station "1" --> "0..*" Terminal : includes >
Station "1" --> "0..*" FreightYard : includes >

class Siding {
  +name
  +length
  +position
}

note right of RailwaySegment
  Sidings only exist on single-track segments.
  Use 'hasSiding' = true only if trackConfiguration = "Single".
end note
RailwaySegment "1" --> "0..*" Siding : includes >
@enduml
