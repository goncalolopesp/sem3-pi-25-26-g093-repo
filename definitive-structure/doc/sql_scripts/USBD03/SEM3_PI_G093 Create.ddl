CREATE TABLE Building (id number(10) GENERATED AS IDENTITY, facilityID number(10) NOT NULL, buildingTypeID number(10) NOT NULL, name varchar2(100) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Building_Type (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Cargo (id number(10) GENERATED AS IDENTITY, cargoTypeID number(10) NOT NULL, buildingID number(10) NOT NULL, quantity number(10, 2) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Cargo_Type (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Diesel_Locomotive (rollingStockModelID number(10) NOT NULL, fuelCapacity number(10, 2) NOT NULL, PRIMARY KEY (rollingStockModelID));
CREATE TABLE Electric_Locomotive (rollingStockModelID number(10) NOT NULL, PRIMARY KEY (rollingStockModelID));
CREATE TABLE Enterprise (id number(10) GENERATED AS IDENTITY, name varchar2(50) NOT NULL, shortName varchar2(20) NOT NULL, vatNumber varchar2(40) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Facility (id number(10) GENERATED AS IDENTITY, facilityTypeID number(10) NOT NULL, name varchar2(100) NOT NULL, posX number(22) NOT NULL, posY number(22) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Facility_Type (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Gauge (id number(10) GENERATED AS IDENTITY, width_mm number(6) NOT NULL, description varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Locomotive_Model (rollingStockModelID number(10) NOT NULL, name varchar2(30) NOT NULL, power number(22) NOT NULL, acceleration number(22) NOT NULL, topSpeed number(22) NOT NULL, startYear number(4) NOT NULL, numberOfBogies number(10) NOT NULL, make varchar2(50) NOT NULL, model varchar2(50) NOT NULL, trackType varchar2(20) NOT NULL, PRIMARY KEY (rollingStockModelID));
CREATE TABLE Operator (enterpriseID number(10) NOT NULL, name varchar2(100) NOT NULL, shortName varchar2(30) NOT NULL, PRIMARY KEY (enterpriseID));
CREATE TABLE Operator_Railway_Line (railwayLineID number(10) NOT NULL, operatorEnterpriseID number(10) NOT NULL, PRIMARY KEY (railwayLineID, operatorEnterpriseID));
CREATE TABLE Owner (enterpriseID number(10) NOT NULL, name varchar2(100) NOT NULL, shortName varchar2(30) NOT NULL, PRIMARY KEY (enterpriseID));
CREATE TABLE Railway_Line (id number(10) GENERATED AS IDENTITY, name varchar2(100) NOT NULL, startFacilityID number(10) NOT NULL, endFacilityID number(10) NOT NULL, ownerEnterpriseID number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Railway_Line_Gauge (railwayLineID number(10) NOT NULL, gaugeID number(10) NOT NULL, PRIMARY KEY (railwayLineID, gaugeID));
CREATE TABLE Railway_Segment (id number(10) GENERATED AS IDENTITY, railwayLineID number(10) NOT NULL, length number(22) NOT NULL, isElectrified char(1) NOT NULL, trackType varchar2(20) NOT NULL, speedLimit number(5) NOT NULL, weightLimit number(22) NOT NULL, segmentOrder number(22) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Rolling_Stock_Model (id number(10) GENERATED AS IDENTITY, operatorEnterpriseID number(10) NOT NULL, tareWeight number(10) NOT NULL, maxWeight number(6, 2) NOT NULL, PRIMARY KEY (id));
CREATE TABLE RollingStock_Supported_Gauge (gaugeID number(10) NOT NULL, rollingStockModelID number(10) NOT NULL, PRIMARY KEY (gaugeID, rollingStockModelID));
CREATE TABLE Siding (id number(10) GENERATED AS IDENTITY, railwaySegmentID number(10) NOT NULL, name varchar2(50) NOT NULL, inicialPos number(22) NOT NULL, finalPos number(22) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Wagon_Model (rollingStockModelID number(10) NOT NULL, wagonTypeid number(10) NOT NULL, capacity number(22) NOT NULL, volumeCapacity number(22) NOT NULL, numberOfBogies number(22) NOT NULL, length number(22) NOT NULL, height number(22) NOT NULL, maxSpeed number(22) NOT NULL, PRIMARY KEY (rollingStockModelID));
CREATE TABLE Wagon_Type (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
ALTER TABLE Electric_Locomotive ADD CONSTRAINT FKElectric_L197762 FOREIGN KEY (rollingStockModelID) REFERENCES Locomotive_Model (rollingStockModelID);
ALTER TABLE Railway_Segment ADD CONSTRAINT FKRailway_Se193688 FOREIGN KEY (railwayLineID) REFERENCES Railway_Line (id);
ALTER TABLE Building ADD CONSTRAINT FKBuilding337242 FOREIGN KEY (buildingTypeID) REFERENCES Building_Type (id);
