ALTER TABLE Operator_Railway_Line ADD CONSTRAINT FKOperator_R744245 FOREIGN KEY (operatorEnterpriseID) REFERENCES Operator (enterpriseID);
ALTER TABLE Siding ADD CONSTRAINT FKSiding702577 FOREIGN KEY (railwaySegmentID) REFERENCES Railway_Segment (id);
ALTER TABLE Cargo ADD CONSTRAINT FKCargo479240 FOREIGN KEY (buildingID) REFERENCES Building (id);
