CREATE TABLE Building (id number(10) GENERATED AS IDENTITY, facilityID number(10) NOT NULL, buildingTypeID number(10) NOT NULL, name varchar2(100) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Building_Type (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Cargo (id number(10) GENERATED AS IDENTITY, cargoTypeID number(10) NOT NULL, buildingID number(10) NOT NULL, quantity number(10, 2) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Cargo_Type (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Diesel_Locomotive_Model (locomotiveModelID number(10) NOT NULL, fuelCapacity number(10, 2) NOT NULL, PRIMARY KEY (locomotiveModelID));
CREATE TABLE Electric_Locomotive_Model (locomotiveModelID number(10) NOT NULL, voltage number(10) NOT NULL, frequence number(10) NOT NULL, PRIMARY KEY (locomotiveModelID));
CREATE TABLE Enterprise (id number(10) GENERATED AS IDENTITY, vatNumber varchar2(40) NOT NULL UNIQUE, name varchar2(50) NOT NULL, shortName varchar2(20) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Facility (id number(10) GENERATED AS IDENTITY, facilityTypeID number(10) NOT NULL, name varchar2(100) NOT NULL, posX number(22) NOT NULL, posY number(22) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Facility_Type (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Gauge (id number(10) GENERATED AS IDENTITY, width_mm number(6) NOT NULL, description varchar2(50) NOT NULL, Gaugeid number(10) NOT NULL, Railway_Lineid number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Gauge_Locomotive_Model (gaugeID number(10) NOT NULL, locomotiveModelID number(10) NOT NULL, PRIMARY KEY (gaugeID, locomotiveModelID));
CREATE TABLE Locomotive (locomotiveID number(10) GENERATED AS IDENTITY, operatorID number(10) NOT NULL, locomotiveModelID number(10) NOT NULL, name varchar2(30) NOT NULL, startYear number(4) NOT NULL, PRIMARY KEY (locomotiveID));
CREATE TABLE Locomotive_Model (locomotiveModelID number(10) GENERATED AS IDENTITY, power double precision NOT NULL, acceleration double precision NOT NULL, topSpeed double precision NOT NULL, trackType number(10) NOT NULL, PRIMARY KEY (locomotiveModelID));
CREATE TABLE Operator (enterpriseID number(10) NOT NULL, PRIMARY KEY (enterpriseID));
CREATE TABLE Owner (enterpriseID number(10) NOT NULL, PRIMARY KEY (enterpriseID));
CREATE TABLE Railway_Line (id number(10) GENERATED AS IDENTITY, name varchar2(100) NOT NULL, startFacilityID number(10) NOT NULL, endFacilityID number(10) NOT NULL, ownerEnterpriseID number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Railway_Segment (id number(10) GENERATED AS IDENTITY, railwayLineID number(10) NOT NULL UNIQUE, segmentOrder number(22) NOT NULL UNIQUE, length number(22) NOT NULL, isElectrified char(1) NOT NULL, trackType varchar2(20) NOT NULL, speedLimit number(5) NOT NULL, weightLimit number(22) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Wagon (wagonID number(10) GENERATED AS IDENTITY, operatorID number(10) NOT NULL, wagonModelID number(10) NOT NULL, name varchar2(30) NOT NULL, PRIMARY KEY (wagonID));
CREATE TABLE Wagon_Model (wagonModelID number(10) GENERATED AS IDENTITY, wagonModelTypeID number(10) NOT NULL, capacity number(10) NOT NULL, volumeCapacity number(10) NOT NULL, length double precision NOT NULL, height number(10) NOT NULL, maxSpeed number(10) NOT NULL, PRIMARY KEY (wagonModelID));
CREATE TABLE Wagon_Model_Gauge (wagonModelID number(10) NOT NULL, Gaugeid number(10) NOT NULL, PRIMARY KEY (wagonModelID, Gaugeid));
CREATE TABLE Wagon_Model_Type (wagonModelTypeID number(10) GENERATED AS IDENTITY, typeName number(10) NOT NULL, PRIMARY KEY (wagonModelTypeID));
ALTER TABLE Railway_Segment ADD CONSTRAINT FKRailway_Se193688 FOREIGN KEY (railwayLineID) REFERENCES Railway_Line (id);
ALTER TABLE Building ADD CONSTRAINT FKBuilding337242 FOREIGN KEY (buildingTypeID) REFERENCES Building_Type (id);
ALTER TABLE Building ADD CONSTRAINT FKBuilding540567 FOREIGN KEY (facilityID) REFERENCES Facility (id);
ALTER TABLE Railway_Line ADD CONSTRAINT FKRailway_Li903128 FOREIGN KEY (ownerEnterpriseID) REFERENCES Owner (enterpriseID);
ALTER TABLE Cargo ADD CONSTRAINT FKCargo686681 FOREIGN KEY (cargoTypeID) REFERENCES Cargo_Type (id);
ALTER TABLE Owner ADD CONSTRAINT FKOwner65769 FOREIGN KEY (enterpriseID) REFERENCES Enterprise (id);
ALTER TABLE Operator ADD CONSTRAINT FKOperator587960 FOREIGN KEY (enterpriseID) REFERENCES Enterprise (id);
ALTER TABLE Cargo ADD CONSTRAINT FKCargo479240 FOREIGN KEY (buildingID) REFERENCES Building (id);
ALTER TABLE Railway_Line ADD CONSTRAINT FKRailway_Li146137 FOREIGN KEY (startFacilityID) REFERENCES Facility (id);
ALTER TABLE Railway_Line ADD CONSTRAINT FKRailway_Li111599 FOREIGN KEY (endFacilityID) REFERENCES Facility (id);
ALTER TABLE Facility ADD CONSTRAINT FKFacility616056 FOREIGN KEY (facilityTypeID) REFERENCES Facility_Type (id);
ALTER TABLE Wagon ADD CONSTRAINT FKWagon197129 FOREIGN KEY (wagonModelID) REFERENCES Wagon_Model (wagonModelID);
ALTER TABLE Locomotive ADD CONSTRAINT FKLocomotive523003 FOREIGN KEY (locomotiveModelID) REFERENCES Locomotive_Model (locomotiveModelID);
ALTER TABLE Electric_Locomotive_Model ADD CONSTRAINT FKElectric_L456013 FOREIGN KEY (locomotiveModelID) REFERENCES Locomotive_Model (locomotiveModelID);
ALTER TABLE Diesel_Locomotive_Model ADD CONSTRAINT FKDiesel_Loc102542 FOREIGN KEY (locomotiveModelID) REFERENCES Locomotive_Model (locomotiveModelID);
ALTER TABLE Wagon ADD CONSTRAINT FKWagon354686 FOREIGN KEY (operatorID) REFERENCES Operator (enterpriseID);
ALTER TABLE Locomotive ADD CONSTRAINT FKLocomotive218850 FOREIGN KEY (operatorID) REFERENCES Operator (enterpriseID);
ALTER TABLE Wagon_Model ADD CONSTRAINT FKWagon_Mode272526 FOREIGN KEY (wagonModelTypeID) REFERENCES Wagon_Model_Type (wagonModelTypeID);
ALTER TABLE Wagon_Model_Gauge ADD CONSTRAINT FKWagon_Mode149530 FOREIGN KEY (wagonModelID) REFERENCES Wagon_Model (wagonModelID);
ALTER TABLE Wagon_Model_Gauge ADD CONSTRAINT FKWagon_Mode72765 FOREIGN KEY (Gaugeid) REFERENCES Gauge (id);
ALTER TABLE Gauge ADD CONSTRAINT FKGauge713132 FOREIGN KEY (Railway_Lineid) REFERENCES Railway_Line (id);
ALTER TABLE Gauge_Locomotive_Model ADD CONSTRAINT FKGauge_Loco92831 FOREIGN KEY (gaugeID) REFERENCES Gauge (id);
ALTER TABLE Gauge_Locomotive_Model ADD CONSTRAINT FKGauge_Loco240253 FOREIGN KEY (locomotiveModelID) REFERENCES Locomotive_Model (locomotiveModelID);

