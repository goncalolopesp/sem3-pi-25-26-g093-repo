ALTER TABLE Railway_Line ADD CONSTRAINT FKRailway_Li111599 FOREIGN KEY (endFacilityID) REFERENCES Facility (id);
ALTER TABLE Facility ADD CONSTRAINT FKFacility616056 FOREIGN KEY (facilityTypeID) REFERENCES Facility_Type (id);
ALTER TABLE Rolling_Stock_Model ADD CONSTRAINT FKRolling_St557589 FOREIGN KEY (operatorEnterpriseID) REFERENCES Operator (enterpriseID);
ALTER TABLE Wagon_Model ADD CONSTRAINT FKWagon_Mode800905 FOREIGN KEY (wagonTypeid) REFERENCES Wagon_Type (id);
ALTER TABLE Diesel_Locomotive ADD CONSTRAINT FKDiesel_Loc582484 FOREIGN KEY (rollingStockModelID) REFERENCES Locomotive_Model (rollingStockModelID);
ALTER TABLE RollingStock_Supported_Gauge ADD CONSTRAINT FKRollingSto436000 FOREIGN KEY (gaugeID) REFERENCES Gauge (id);
ALTER TABLE RollingStock_Supported_Gauge ADD CONSTRAINT FKRollingSto656493 FOREIGN KEY (rollingStockModelID) REFERENCES Rolling_Stock_Model (id);
ALTER TABLE Railway_Line_Gauge ADD CONSTRAINT FKRailway_Li266937 FOREIGN KEY (railwayLineID) REFERENCES Railway_Line (id);
