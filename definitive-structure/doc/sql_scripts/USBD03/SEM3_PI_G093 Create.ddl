CREATE TABLE Building (id number(10) GENERATED AS IDENTITY, name varchar2(50) NOT NULL, BuildingType number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE BuildingType (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Cargo (id number(10) GENERATED AS IDENTITY, quantity double precision NOT NULL, CargoType number(10) NOT NULL, Freight number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE CargoType (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE DieselLocomotive (id number(10) NOT NULL, fuelCapacity double precision, PRIMARY KEY (id));
CREATE TABLE ElectricLocomotive (id number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Freight (id number(10) GENERATED AS IDENTITY, status varchar2(50) NOT NULL, Train number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Locomotive (id number(10) GENERATED AS IDENTITY, name varchar2(30) NOT NULL, power double precision NOT NULL, acceleration double precision NOT NULL, topSpeed double precision NOT NULL, weight double precision NOT NULL, startYear number(4) NOT NULL, gauge double precision NOT NULL, numberOfBogies number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Operator (id number(10) GENERATED AS IDENTITY, name varchar2(30) NOT NULL, OperatorType number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE OperatorType (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE RailwayLine (id number(10) GENERATED AS IDENTITY, name varchar2(50) NOT NULL, length double precision NOT NULL, TrackType number(10) NOT NULL, Operator number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE RailwaySegment (id number(10) GENERATED AS IDENTITY, length double precision NOT NULL, gauge double precision NOT NULL, isElectrified raw(1) NOT NULL, trackConfiguration varchar2(50) NOT NULL, speedLimit double precision NOT NULL, weightLimit double precision NOT NULL, TrackType number(10) NOT NULL, RailwayLine number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Route (id number(10) GENERATED AS IDENTITY, name varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE RouteStation (id number(10) NOT NULL, Stationid number(10) NOT NULL, Routeid number(10) NOT NULL, sequenceOrder varchar2(50) NOT NULL, PRIMARY KEY (id, Stationid, Routeid));
CREATE TABLE Station (id number(10) GENERATED AS IDENTITY, name varchar2(50) NOT NULL, posX number(10) NOT NULL, posY number(10) NOT NULL, StationType number(10) NOT NULL, Freight number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Station_Building (Station number(10) NOT NULL, Building number(10) NOT NULL, PRIMARY KEY (Station, Building));
CREATE TABLE Station_RailwayLine (Station number(10) NOT NULL, RailwayLine number(10) NOT NULL, PRIMARY KEY (Station, RailwayLine));
CREATE TABLE StationType (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE TrackType (id number(10) GENERATED AS IDENTITY, name varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Train (id number(10) GENERATED AS IDENTITY, name varchar2(50) NOT NULL, length number(10) NOT NULL, purchaseDate date NOT NULL, Operator number(10) NOT NULL, Locomotive number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE TrainWagon (Train number(10) NOT NULL, Wagon number(10) NOT NULL, PRIMARY KEY (Train, Wagon));
CREATE TABLE Wagon (id number(10) GENERATED AS IDENTITY, capacity double precision NOT NULL, volumeCapacity double precision NOT NULL, tareWeight double precision NOT NULL, gauge double precision NOT NULL, WagonType number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE WagonType (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
