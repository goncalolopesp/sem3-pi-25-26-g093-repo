CREATE TABLE Building (id number(10) GENERATED AS IDENTITY, buildingTypeID number(10) NOT NULL, stationID number(10) NOT NULL, name varchar2(100) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Building_Type (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Cargo (id number(10) GENERATED AS IDENTITY, cargoType number(10) NOT NULL, wagonID number(10) NOT NULL, buildingID number(10) NOT NULL, quantity double precision NOT NULL, PRIMARY KEY (id));
CREATE TABLE Cargo_Type (id number(10) GENERATED AS IDENTITY, typeName varchar2(50) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Diesel_Locomotive (id number(10) NOT NULL, fuelCapacity double precision NOT NULL, PRIMARY KEY (id));
CREATE TABLE Electric_Locomotive (id number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Enterprise (id number(10) GENERATED AS IDENTITY, name varchar2(30) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Freight_Yard (id number(10) GENERATED AS IDENTITY, stationID number(10) NOT NULL, storageCapacity number(10) NOT NULL, numTracks number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Locomotive (id number(10) GENERATED AS IDENTITY, rollingStockID number(10) NOT NULL, operatorID number(10) NOT NULL, name varchar2(30) NOT NULL, power double precision NOT NULL, acceleration double precision NOT NULL, topSpeed double precision NOT NULL, startYear number(4) NOT NULL, numberOfBogies number(10) NOT NULL, make number(10) NOT NULL, model number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Operator (id number(10) GENERATED AS IDENTITY, enterpriseID number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Operator_Railway_Line (railwayLineID number(10) NOT NULL, operatorID number(10) NOT NULL, PRIMARY KEY (railwayLineID, operatorID));
CREATE TABLE Owner (id number(10) GENERATED AS IDENTITY, enterpriseID number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Railway_Line (id number(10) GENERATED AS IDENTITY, ownerID number(10) NOT NULL, name varchar2(100) NOT NULL, length double precision NOT NULL, startStation number(10) NOT NULL, endStation number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Railway_Segment (id number(10) GENERATED AS IDENTITY, railwayLineID number(10) NOT NULL, length double precision NOT NULL, gauge double precision NOT NULL, isElectrified raw(1), trackConfiguration varchar2(30) NOT NULL, speedLimit double precision NOT NULL, weightLimit double precision NOT NULL, trackType varchar2(30) NOT NULL, hasSiding raw(1), PRIMARY KEY (id));
CREATE TABLE RollingStock (id number(10) GENERATED AS IDENTITY, gauge number(10) NOT NULL, tareWieght double precision NOT NULL, maxWeight double precision NOT NULL, PRIMARY KEY (id));
CREATE TABLE Route (id number(10) GENERATED AS IDENTITY, operatorID number(10) NOT NULL, isComplex number(1) NOT NULL, PRIMARY KEY (id));
CREATE TABLE RouteStation (stationID number(10) NOT NULL, routeID number(10) NOT NULL, sequenceOrder number(3) NOT NULL);
CREATE TABLE Siding (id number(10) GENERATED AS IDENTITY, railwaySegmentID number(10) NOT NULL, name varchar2(30) NOT NULL, length double precision NOT NULL, posX number(10) NOT NULL, posY number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Station (id number(10) GENERATED AS IDENTITY, name varchar2(100) NOT NULL, posX number(10) NOT NULL, posY number(10) NOT NULL, isIntermodal number(1) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Station_Railway_Line (stationID number(10) NOT NULL, railwayLineID number(10) NOT NULL, PRIMARY KEY (stationID, railwayLineID));
CREATE TABLE Terminal (id number(10) GENERATED AS IDENTITY, stationID number(10) NOT NULL, capacity number(10) NOT NULL, PRIMARY KEY (id));
CREATE TABLE Wagon (id number(10) GENERATED AS IDENTITY, rollingStockID number(10) NOT NULL, operatorID number(10) NOT NULL, capacity double precision NOT NULL, volumeCapacity double precision NOT NULL, PRIMARY KEY (id));
CREATE TABLE Wagon_Box_Car (wagonID number(10) NOT NULL, goodsType number(10) NOT NULL);
CREATE TABLE Wagon_Flat_Car (wagonID number(10) NOT NULL, groupType number(10) NOT NULL);
CREATE TABLE Wagon_Hopper_Car (wagonID number(10) NOT NULL, materialType number(10) NOT NULL);
CREATE TABLE Wagon_Refrigerated_Car (wagonID number(10) NOT NULL, temperatureRange number(10) NOT NULL);
CREATE TABLE Wagon_Tank_Car (wagonID number(10) NOT NULL, liquidType number(10) NOT NULL);
